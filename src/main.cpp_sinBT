#include <Arduino.h>
#include "esp_camera.h"
#include "FS.h"
#include "SD_MMC.h"
#include "soc/soc.h"           // Para deshabilitar Brownout Detector
#include "soc/rtc_cntl_reg.h"  // Para deshabilitar Brownout Detector

// ===================================
// === PINES Y CONFIGURACIÓN HARDWARE ===
// ===================================

// Pines del ESP32-CAM AI-Thinker (Estándar)
#define PWDN_GPIO_NUM    32
#define RESET_GPIO_NUM   -1
#define XCLK_GPIO_NUM    0
#define SIOD_GPIO_NUM    26
#define SIOC_GPIO_NUM    27

#define Y9_GPIO_NUM      35
#define Y8_GPIO_NUM      34
#define Y7_GPIO_NUM      39
#define Y6_GPIO_NUM      36
#define Y5_GPIO_NUM      21
#define Y4_GPIO_NUM      19
#define Y3_GPIO_NUM      18
#define Y2_GPIO_NUM      5
#define VSYNC_GPIO_NUM   25
#define HREF_GPIO_NUM    23
#define PCLK_GPIO_NUM    22

// Pines de Usuario
#define BUTTON_PIN       12    // PIN DEL BOTÓN SOLICITADO
#define FLASH_PIN        4     // LED Flash/Linterna

// Variables para control del botón
bool captura_en_curso = false;
unsigned long ultimo_tiempo_pulsacion = 0;
const unsigned long tiempo_debounce = 200; // ms

// ===================================
// === PROTOTYPES (Para evitar errores de compilación) ===
// ===================================

bool inicializar_camara();
void guardar_foto_sd();
void flashOn();
void flashOff();

// ===================================
// === SETUP ===
// ===================================

void setup() {
    Serial.begin(115200);
    // Serial.begin(57600);
    delay(2000);

    // ESTE MENSAJE DEBE APARECER PRIMERO
    Serial.println("--------------------------------");
    Serial.println("--- PRUEBA DE ARRANQUE INICIADA ---");
    // --------------------------------
    Serial.println("Iniciando sistema ESP32-CAM...");

    // Deshabilitar Brownout Detector para mayor estabilidad
    WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);

    // Configurar pines
    pinMode(BUTTON_PIN, INPUT_PULLUP); // Botón conectado entre GPIO 12 y GND
    pinMode(FLASH_PIN, OUTPUT);
    digitalWrite(FLASH_PIN, LOW); // Asegurar que el flash esté apagado al inicio

    // Iniciar SD Card usando SD_MMC (la más común en ESP32-CAM)
    if (!SD_MMC.begin()) {
        Serial.println("FATAL: Error al montar la tarjeta SD. Verifique la conexión.");
        return;
    }
    Serial.println("SD Card montada correctamente.");

    // Iniciar Cámara
    if (!inicializar_camara()) {
        Serial.println("FATAL: El programa se detiene por error de cámara.");
        return;
    }
    Serial.println("Cámara iniciada. Presiona el botón en GPIO 12.");
}

// ===================================
// === LOOP ===
// ===================================

void loop() {
    // Lectura del botón: LOW significa presionado (debido a INPUT_PULLUP)
    //
    if (digitalRead(BUTTON_PIN) == LOW && !captura_en_curso) {
        Serial.println("Boton presionado.");
        // Anti-rebote (Debounce)
        if (millis() - ultimo_tiempo_pulsacion > tiempo_debounce) {
            ultimo_tiempo_pulsacion = millis();
            captura_en_curso = true;

            guardar_foto_sd();

            captura_en_curso = false;
        }
    }
    delay(500);
}

// ===================================
// === FUNCIONES AUXILIARES ===
// ===================================

/**
 * @brief Configura e inicializa la cámara con la máxima calidad.
 */

bool inicializar_camara() {
  camera_config_t config;
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;
  config.fb_location = CAMERA_FB_IN_PSRAM;

  // Configuración más conservadora para evitar errores de memoria
  if(psramFound()){
    Serial.println("✅ pic size 1024x768 ");
    config.frame_size = FRAMESIZE_XGA; // 1024x768
    config.jpeg_quality = 10;
    config.fb_count = 2;
    Serial.println("PSRAM encontrado - Configuración XGA");
  } else {
    Serial.println("✅ pic size 800x600 ");
    config.frame_size = FRAMESIZE_SVGA; // 800x600
    config.jpeg_quality = 12;
    config.fb_count = 1;
    Serial.println("PSRAM no encontrado - Configuración SVGA");
  }

  // Configuración adicional para reducir uso de memoria
  config.grab_mode = CAMERA_GRAB_LATEST;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("❌ Error inicializando cámara: 0x%x\n", err);

    // Intentar con configuración aún más baja
    Serial.println("🔄 Intentando con configuración CIF...");
    config.frame_size = FRAMESIZE_CIF;
    config.jpeg_quality = 15;
    config.fb_count = 1;

    err = esp_camera_init(&config);
    if (err != ESP_OK) {
      Serial.printf("❌ Error en segundo intento: 0x%x\n", err);
      return false;
    }
    Serial.println("✅ Cámara inicializada en modo CIF");
  } else {
    Serial.println("✅ Cámara inicializada correctamente");
  }

  // Configurar parámetros adicionales de la cámara
  sensor_t *s = esp_camera_sensor_get();
  if (s != NULL) {
    s->set_brightness(s, 0);     // -2 to 2
    s->set_contrast(s, 0);       // -2 to 2
    s->set_saturation(s, 0);     // -2 to 2
    s->set_special_effect(s, 0); // 0 to 6 (0 - No Effect)
    s->set_whitebal(s, 1);       // 0 = disable , 1 = enable
    s->set_awb_gain(s, 1);       // 0 = disable , 1 = enable
    s->set_wb_mode(s, 0);        // 0 to 4 - if awb_gain enabled (0 - Auto, 1 - Sunny, 2 - Cloudy, 3 - Office, 4 - Home)
    s->set_exposure_ctrl(s, 1);  // 0 = disable , 1 = enable
    s->set_aec2(s, 0);           // 0 = disable , 1 = enable
    s->set_ae_level(s, 0);       // -2 to 2
    s->set_aec_value(s, 300);    // 0 to 1200
    s->set_gain_ctrl(s, 1);      // 0 = disable , 1 = enable
    s->set_agc_gain(s, 0);       // 0 to 30
    s->set_gainceiling(s, (gainceiling_t)0);  // 0 to 6
    s->set_bpc(s, 0);            // 0 = disable , 1 = enable
    s->set_wpc(s, 1);            // 0 = disable , 1 = enable
    s->set_raw_gma(s, 1);        // 0 = disable , 1 = enable
    s->set_lenc(s, 1);           // 0 = disable , 1 = enable
    s->set_hmirror(s, 0);        // 0 = disable , 1 = enable
    s->set_vflip(s, 0);          // 0 = disable , 1 = enable
    s->set_dcw(s, 1);            // 0 = disable , 1 = enable
    s->set_colorbar(s, 0);       // 0 = disable , 1 = enable
  }

  return true;
}

/**
 * @brief Enciende el LED Flash.
 */
void flashOn() {
    digitalWrite(FLASH_PIN, HIGH);
    delay(500); // Tiempo para que el flash se estabilice antes de la captura
}

/**
 * @brief Apaga el LED Flash.
 */
void flashOff() {
    digitalWrite(FLASH_PIN, LOW);
}

/**
 * @brief Toma y guarda la foto con nombre basado en el tiempo.
 */
void guardar_foto_sd() {
    Serial.println("Iniciando captura en QXGA...");
    flashOn(); // Encender flash

    // ---- Capturar imagen ----
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) {
        Serial.println("FALLO: No se pudo obtener el frame buffer");
        flashOff();
        return;
    }

    // ---- Crear nombre único de archivo ----
    String path = "/fotos/foto_" + String(millis()) + ".jpg";

    // ---- Guardar archivo en SD ----
    File file = SD_MMC.open(path, FILE_WRITE);
    if (!file) {
        Serial.println("FALLO: No se pudo crear/abrir archivo en SD");
    } else {
        file.write(fb->buf, fb->len);
        file.close();
        Serial.println("ÉXITO: Foto guardada en: " + path);
        Serial.printf("Tamaño del archivo: %d bytes\n", fb->len);
    }

    flashOff(); // Apagar flash
    esp_camera_fb_return(fb); // Liberar frame buffer
    Serial.println("Captura finalizada.");
}
