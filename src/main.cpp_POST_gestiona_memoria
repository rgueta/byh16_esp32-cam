void setup() {
  Serial.begin(115200);
  Serial.setDebugOutput(true);
  Serial.println("\n=== ESP32-CAM OPTIMIZADO ===");

  // Aumentar buffer serial para debugging
  Serial.setTxBufferSize(2048);

  pinMode(BUTTON_PIN, INPUT_PULLUP);
  Serial.printf("✅ Botón en GPIO %d\n", BUTTON_PIN);

  // Bluetooth
  if (bluetoothEnabled) {
    if (!SerialBT.begin(deviceName)) {
      Serial.println("❌ Error en Bluetooth");
      bluetoothEnabled = false;
    } else {
      Serial.printf("✅ Bluetooth: %s\n", deviceName);
    }
  }

  // WiFi con configuración optimizada
  setupWiFi();

  // Cámara con configuración balanceada
  Serial.println("📷 Inicializando cámara...");
  if (!setupCamera()) {
    Serial.println("❌ Error en cámara!");
    return;
  }

  // SD Card
  Serial.println("💾 Inicializando SD...");
  sdCardReady = setupSDCard();

  Serial.println("\n🎯 SISTEMA LISTO");
  Serial.printf("🌐 Servidor: %s\n", serverURL);
  Serial.println("📱 Comandos: FOTO, ENVIAR, POST, STATUS");
}

void setupWiFi() {
  Serial.printf("📡 Conectando a: %s\n", ssid);

  // Configuración WiFi optimizada
  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);

  WiFi.begin(ssid, password);

  int attempts = 0;
  while (WiFi.status() != WL_CONNECTED && attempts < 25) {
    delay(1000);
    attempts++;
    Serial.print(".");
  }

  if (WiFi.status() == WL_CONNECTED) {
    wifiConnected = true;
    Serial.println("\n✅ WiFi conectado!");
    Serial.printf("📶 IP: %s\n", WiFi.localIP().toString().c_str());
    Serial.printf("📶 RSSI: %d dBm\n", WiFi.RSSI());
  } else {
    Serial.println("\n❌ Error en WiFi");
  }
}

bool setupCamera() {
  camera_config_t config;

  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 20000000;
  config.fb_location = CAMERA_FB_IN_PSRAM;
  // Configuración BALANCEADA (no máxima calidad para evitar timeouts)
  config.pixel_format = PIXFORMAT_JPEG;
  // config.frame_size = FRAMESIZE_SVGA; // 800x600 - Balance entre calidad y tamaño
  // config.jpeg_quality = 12; // Calidad media (0-63, menor es mejor)
  config.frame_size = FRAMESIZE_XGA; // 1024x768 - Balance entre calidad y tamaño
  config.jpeg_quality = 10; // Calidad media (0-63, menor es mejor)

  config.fb_count = 2; // Dos buffers para mejor rendimiento

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("❌ Error cámara: 0x%x\n", err);
    return false;
  }

  // Configuración adicional del sensor
  sensor_t *s = esp_camera_sensor_get();
  if (s != NULL) {
    s->set_framesize(s, FRAMESIZE_SVGA);
    s->set_quality(s, 12);
  }

  Serial.println("✅ Cámara optimizada lista");
  return true;
}

bool setupSDCard() {
  if (SD_MMC.begin("/sdcard", true)) {
    if (SD_MMC.cardType() != CARD_NONE) {
      if(!SD_MMC.exists("/fotos")){
        SD_MMC.mkdir("/fotos");
      }
      Serial.println("✅ SD lista");
      return true;
    }
  }
  Serial.println("❌ SD no disponible");
  return false;
}

String lastPhotoPath = "";

bool sendPhotoToServer(const uint8_t* imageData, size_t imageSize, const String& filename) {
  if (!wifiConnected || WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ WiFi no conectado");
    return false;
  }

  Serial.println("\n📡 ENVIANDO FOTO AL SERVIDOR...");
  Serial.printf("📏 Tamaño: %d bytes\n", imageSize);
  Serial.printf("🌐 URL: %s\n", serverURL);

  // Liberar memoria antes de enviar
  if (ESP.getFreeHeap() < 40000) {
    Serial.println("⚠️  Memoria baja, liberando...");
    WiFi.disconnect(true);
    WiFi.begin(ssid, password);
    delay(2000);
  }

  Serial.printf("💾 Memoria libre: %d bytes\n", ESP.getFreeHeap());

  HTTPClient http;

  // Timeouts extendidos para fotos grandes
  http.setConnectTimeout(HTTP_CONNECT_TIMEOUT);
  http.setTimeout(HTTP_RESPONSE_TIMEOUT);
  http.setReuse(true);

  Serial.println("🔗 Iniciando conexión HTTP...");

  if (!http.begin(serverURL)) {
    Serial.println("❌ Error en http.begin()");
    return false;
  }

  // Headers optimizados
  http.addHeader("Content-Type", "application/octet-stream");
  http.addHeader("Authorization", authToken);
  http.addHeader("X-Filename", filename);
  http.addHeader("X-Size", String(imageSize));

  Serial.println("📤 Preparando envío de datos...");

  // Método OPTIMIZADO: Enviar en chunks si es muy grande
  bool success = false;

  if (imageSize > 50000) {
    Serial.println("🔧 Usando método optimizado para foto grande...");
    success = sendLargePhoto(http, imageData, imageSize);
  } else {
    // Método normal para fotos pequeñas
    success = sendNormalPhoto(http, imageData, imageSize);
  }

  http.end();

  // Liberar memoria después del envío
  if (ESP.getFreeHeap() < 30000) {
    Serial.println("🧹 Liberando memoria...");
    delay(1000);
  }

  return success;
}

bool sendNormalPhoto(HTTPClient& http, const uint8_t* imageData, size_t imageSize) {
  Serial.println("📤 Enviando foto (método normal)...");

  uint8_t* postData = (uint8_t*)malloc(imageSize);
  if (!postData) {
    Serial.println("❌ Error asignando memoria");
    return false;
  }

  memcpy(postData, imageData, imageSize);

  int httpResponseCode = http.POST(postData, imageSize);
  free(postData);

  Serial.printf("📡 Código respuesta: %d\n", httpResponseCode);

  if (httpResponseCode > 0) {
    String response = http.getString();
    Serial.printf("✅ ÉXITO! Respuesta: %s\n", response.c_str());
    return true;
  } else {
    Serial.printf("❌ ERROR: %s\n", http.errorToString(httpResponseCode).c_str());
    return false;
  }
}

bool sendLargePhoto(HTTPClient& http, const uint8_t* imageData, size_t imageSize) {
  Serial.println("📤 Enviando foto grande (método chunked)...");

  // Método alternativo para fotos muy grandes
  WiFiClient* client = http.getStreamPtr();
  if (!client) {
    Serial.println("❌ No se pudo obtener stream client");
    return false;
  }

  // Enviar headers manualmente
  String headers = String("POST ") + "/upload" + " HTTP/1.1\r\n" +
                  "Host: 192.168.1.170:5000\r\n" +
                  "Content-Type: application/octet-stream\r\n" +
                  "Authorization: " + authToken + "\r\n" +
                  "Content-Length: " + String(imageSize) + "\r\n" +
                  "Connection: close\r\n\r\n";

  if (client->connect("192.168.1.170", 5000)) {
    // Enviar headers
    client->print(headers);

    // Enviar datos en chunks
    const size_t CHUNK_SIZE = 4096;
    size_t sent = 0;

    while (sent < imageSize) {
      size_t toSend = min(CHUNK_SIZE, imageSize - sent);
      size_t actuallySent = client->write(imageData + sent, toSend);

      if (actuallySent == 0) {
        Serial.println("❌ Error enviando chunk");
        client->stop();
        return false;
      }

      sent += actuallySent;
      Serial.printf("📦 Progreso: %d/%d bytes (%.1f%%)\r", sent, imageSize, (sent * 100.0) / imageSize);
      delay(10); // Pequeña pausa para evitar saturación
    }

    Serial.println("\n✅ Datos enviados, esperando respuesta...");

    // Leer respuesta
    unsigned long timeout = millis();
    while (!client->available() && millis() - timeout < 10000) {
      delay(100);
    }

    if (client->available()) {
      String response = client->readString();
      Serial.printf("📨 Respuesta: %s\n", response.c_str());

      if (response.indexOf("200") > 0 || response.indexOf("success") > 0) {
        client->stop();
        return true;
      }
    }

    client->stop();
    return false;
  } else {
    Serial.println("❌ No se pudo conectar para envío chunked");
    return false;
  }
}

void takePhoto(bool upload = false) {
  photoCounter++;
  Serial.printf("\n📸 TOMANDO FOTO #%d\n", photoCounter);

  // Liberar memoria antes de capturar
  if (ESP.getFreeHeap() < 50000) {
    Serial.println("🧹 Liberando memoria antes de captura...");
    delay(500);
  }

  // Capturar foto
  camera_fb_t *fb = esp_camera_fb_get();
  if (!fb) {
    Serial.println("❌ Error capturando foto");
    return;
  }

  Serial.printf("✅ Foto capturada: %d bytes\n", fb->len);
  Serial.printf("💾 Memoria libre: %d bytes\n", ESP.getFreeHeap());

  // Guardar en SD
  String filename = "/fotos/foto_" + String(photoCounter) + "_" + String(millis()) + ".jpg";
  File file = SD_MMC.open(filename, FILE_WRITE);
  if (file) {
    size_t written = file.write(fb->buf, fb->len);
    file.close();

    if (written == fb->len) {
      lastPhotoPath = filename;
      Serial.println("💾 Guardada en SD");

      if (bluetoothEnabled) {
        SerialBT.printf("✅ Foto #%d guardada (%d bytes)\n", photoCounter, fb->len);
      }
    } else {
      Serial.println("❌ Error guardando en SD");
    }
  }

  // Enviar al servidor si se solicita
  if (upload && wifiConnected) {
    Serial.println("🚀 Preparando envío al servidor...");

    // Pequeña pausa para estabilizar
    delay(1000);

    if (sendPhotoToServer(fb->buf, fb->len, filename)) {
      Serial.println("🎉 Foto enviada al servidor!");
      if (bluetoothEnabled) {
        SerialBT.println("🎉 Foto enviada al servidor!");
      }
    } else {
      Serial.println("❌ Error enviando foto");
      if (bluetoothEnabled) {
        SerialBT.println("❌ Error enviando foto");
      }
    }
  }

  // Liberar frame buffer inmediatamente
  esp_camera_fb_return(fb);

  Serial.printf("💾 Memoria después: %d bytes\n", ESP.getFreeHeap());
}

void sendStatus() {
  if (!bluetoothEnabled) return;

  SerialBT.println("\n=== ESTADO ===");
  SerialBT.printf("📷 Fotos: %d\n", photoCounter);
  SerialBT.printf("💾 SD: %s\n", sdCardReady ? "✅" : "❌");
  SerialBT.printf("📡 WiFi: %s\n", wifiConnected ? "✅" : "❌");
  SerialBT.printf("🌐 Servidor: %s\n", serverURL);
  SerialBT.printf("💻 Memoria libre: %d bytes\n", ESP.getFreeHeap());

  if (lastPhotoPath != "") {
    SerialBT.printf("📸 Última foto: %s\n", lastPhotoPath.c_str());
  }
}

void processBluetoothCommand(String command) {
  command.toUpperCase();
  command.trim();

  Serial.printf("📱 Comando: %s\n", command.c_str());

  if (command == "FOTO" || command == "CAPTURE") {
    SerialBT.println("📸 Tomando foto...");
    takePhoto(false);
  }
  else if (command == "ENVIAR" || command == "UPLOAD") {
    SerialBT.println("🚀 Tomando y enviando foto...");
    takePhoto(true);
  }
  else if (command == "POST") {
    if (lastPhotoPath == "") {
      SerialBT.println("❌ No hay foto para enviar");
      return;
    }
    SerialBT.println("📡 Enviando última foto...");

    File file = SD_MMC.open(lastPhotoPath.c_str(), FILE_READ);
    if (!file) {
      SerialBT.println("❌ Error abriendo foto");
      return;
    }

    size_t fileSize = file.size();
    uint8_t* buffer = (uint8_t*)malloc(fileSize);
    if (!buffer) {
      SerialBT.println("❌ Error de memoria");
      file.close();
      return;
    }

    file.read(buffer, fileSize);
    file.close();

    bool success = sendPhotoToServer(buffer, fileSize, lastPhotoPath);
    free(buffer);

    SerialBT.println(success ? "✅ Foto enviada" : "❌ Error enviando");
  }
  else if (command == "STATUS") {
    sendStatus();
  }
  else if (command == "MEMORIA") {
    SerialBT.printf("💻 Memoria libre: %d bytes\n", ESP.getFreeHeap());
  }
  else if (command == "CALIDAD") {
    // Cambiar a menor calidad para testing
    sensor_t *s = esp_camera_sensor_get();
    if (s != NULL) {
      s->set_quality(s, 20); // Calidad más baja
      SerialBT.println("🔧 Calidad reducida para testing");
    }
  }
  else {
    SerialBT.println("❌ Comando no reconocido");
    SerialBT.println("Comandos: FOTO, ENVIAR, POST, STATUS, MEMORIA, CALIDAD");
  }
}

void loop() {
  // Procesar comandos Bluetooth
  if (bluetoothEnabled && SerialBT.available()) {
    String command = SerialBT.readString();
    command.trim();
    processBluetoothCommand(command);
  }

  // Control del botón físico
  bool currentButtonState = digitalRead(BUTTON_PIN);

  if (currentButtonState != lastButtonState) {
    lastDebounceTime = millis();
  }

  if ((millis() - lastDebounceTime) > debounceDelay) {
    if (currentButtonState == LOW && !buttonPressed) {
      buttonPressed = true;
      Serial.println("🔘 Botón físico presionado");
      takePhoto(false);
    }
    else if (currentButtonState == HIGH && buttonPressed) {
      buttonPressed = false;
    }
  }

  lastButtonState = currentButtonState;
  delay(50);
}
