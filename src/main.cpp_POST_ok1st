// Pin del botón físico
#define BUTTON_PIN 12
#define FLASH_PIN        4     // LED Flash/Linterna

// Configuración WiFi
const char* ssid = "FamGuEst_2.4";
const char* password = "l0l1t@..:)";
const char* serverHost = "192.168.1.170";
const int serverPort = 5000;
const char* authToken = "Bearer 1234";

// Objeto Bluetooth
BluetoothSerial SerialBT;

// Variables globales
bool buttonPressed = false;
unsigned long lastDebounceTime = 0;
unsigned long debounceDelay = 50;
bool lastButtonState = HIGH;
int photoCounter = 0;
bool bluetoothEnabled = true;
bool sdCardReady = false;

const char* deviceName = "ESP32-CAM-HD";

void setupWiFi();
bool setupCameraHD();
bool setupSDCard();
void flashOn();
void flashOff();

// Buffer para la última foto capturada (en RAM temporal)
uint8_t* lastPhotoBuffer = nullptr;
size_t lastPhotoSize = 0;
String lastPhotoSDpath = "";

void setup() {
  Serial.begin(115200);
  Serial.setDebugOutput(true);
  Serial.println("\n=== ESP32-CAM SVGA - ENVIAR FOTO ACTUAL ===");

  Serial.printf("💾 Memoria inicial: %d bytes\n", ESP.getFreeHeap());

  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(FLASH_PIN, OUTPUT);
  digitalWrite(FLASH_PIN, LOW); // Asegurar que el flash esté apagado al inicio

  // Bluetooth
  if (bluetoothEnabled && ESP.getFreeHeap() > 15000) {
    if (!SerialBT.begin(deviceName)) {
      Serial.println("❌ Error en Bluetooth");
      bluetoothEnabled = false;
    } else {
      Serial.printf("✅ Bluetooth: %s\n", deviceName);
    }
  } else {
    bluetoothEnabled = false;
    Serial.println("⚠️  Bluetooth desactivado");
  }

  // WiFi
  setupWiFi();

  // Cámara HD
  Serial.println("📷 Inicializando cámara HD...");
  if (!setupCameraHD()) {
    Serial.println("❌ Error en cámara HD!");
    return;
  }

  // SD Card
  sdCardReady = setupSDCard();

  Serial.println("\n🎯 SISTEMA LISTO (1024x768)");
  Serial.printf("💾 Memoria libre: %d bytes\n", ESP.getFreeHeap());
  Serial.println("📱 ENVIAR: Envía la foto actual recién tomada");
  Serial.println("📱 POST: Envía la última foto guardada en SD");

  flashOn();
  flashOff();
  delay(300);
  flashOn();
  flashOff();

}

void setupWiFi() {
  Serial.printf("📡 Conectando a: %s\n", ssid);

  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);

  WiFi.begin(ssid, password);

  for (int i = 0; i < 20; i++) {
    if (WiFi.status() == WL_CONNECTED) {
      Serial.println("\n✅ WiFi conectado!");
      Serial.printf("📶 IP: %s\n", WiFi.localIP().toString().c_str());
      return;
    }
    delay(1000);
    Serial.print(".");
  }
  Serial.println("\n❌ Error en WiFi");
}

bool setupCameraHD() {
  camera_config_t config;

  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 10000000;

  config.pixel_format = PIXFORMAT_JPEG;
  // config.frame_size = FRAMESIZE_XGA; // 1024x768
  config.frame_size = FRAMESIZE_SVGA; // 800x600
  config.jpeg_quality = 10;
  config.fb_count = 1;
  config.fb_location = CAMERA_FB_IN_PSRAM;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("❌ Error cámara: 0x%x\n", err);
    return false;
  }

  Serial.printf("✅ Cámara HD lista. Memoria: %d bytes\n", ESP.getFreeHeap());
  return true;
}

bool setupSDCard() {
  if (ESP.getFreeHeap() < 10000) return false;

  if (SD_MMC.begin("/sdcard", true)) {
    if (SD_MMC.cardType() != CARD_NONE) {
      if(!SD_MMC.exists("/fotos")){
        SD_MMC.mkdir("/fotos");
      }
      Serial.println("✅ SD lista");
      return true;
    }
  }
  return false;
}

void freeLastPhotoBuffer() {
  if (lastPhotoBuffer != nullptr) {
    free(lastPhotoBuffer);
    lastPhotoBuffer = nullptr;
    lastPhotoSize = 0;
  }
}

bool sendPhotoDirect(const uint8_t* imageData, size_t imageSize, const String& filename) {
  Serial.println("\n📡 ENVIANDO FOTO DIRECTAMENTE");
  Serial.printf("📏 Tamaño: %d bytes\n", imageSize);
  Serial.printf("💾 Memoria antes: %d bytes\n", ESP.getFreeHeap());

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ WiFi no conectado");
    return false;
  }

  WiFiClient client;
  Serial.println("🔗 Conectando al servidor...");

  if (!client.connect(serverHost, serverPort)) {
    Serial.println("❌ No se pudo conectar al servidor");
    return false;
  }

  Serial.println("✅ Conectado, preparando envío...");

  // Construir request HTTP
  String headers = String("POST /upload HTTP/1.1\r\n") +
                  "Host: " + String(serverHost) + ":" + String(serverPort) + "\r\n" +
                  "Content-Type: application/octet-stream\r\n" +
                  "Authorization: " + String(authToken) + "\r\n" +
                  "Content-Length: " + String(imageSize) + "\r\n" +
                  "Connection: close\r\n\r\n";

  // Enviar headers
  client.print(headers);

  // Enviar datos DIRECTAMENTE desde imageData
  size_t sent = 0;
  const size_t CHUNK_SIZE = 512; // Chunks más pequeños para memoria baja
  // const size_t CHUNK_SIZE = 1024; // Chunks medio para prueba de memoria

  while (sent < imageSize) {
    size_t toSend = min(CHUNK_SIZE, imageSize - sent);

    // Enviar chunk directamente desde imageData
    size_t written = client.write(imageData + sent, toSend);

    if (written == 0) {
      Serial.println("❌ Error enviando chunk");
      client.stop();
      return false;
    }

    sent += written;

    // Mostrar progreso
    if (sent % 5120 == 0 || sent == imageSize) {
      Serial.printf("📦 Progreso: %d/%d bytes\n", sent, imageSize);
    }

    delay(2);
  }

  Serial.println("✅ Datos enviados, esperando respuesta...");

  // Esperar respuesta
  unsigned long startTime = millis();
  while (!client.available() && millis() - startTime < 10000) {
    delay(10);
  }

  bool success = false;
  if (client.available()) {
    String response = client.readStringUntil('\n');
    Serial.printf("📨 Respuesta: %s\n", response.c_str());

    if (response.indexOf("200") > 0 || response.indexOf("OK") > 0) {
      success = true;
      Serial.println("🎉 Foto enviada exitosamente!");
    }
  } else {
    Serial.println("❌ Timeout esperando respuesta");
  }

  client.stop();
  return success;
}

bool savePhotoToSD(const uint8_t* imageData, size_t imageSize) {
  if (!sdCardReady) return false;

  String filename = "/fotos/foto_" + String(photoCounter) + "_" + String(millis()) + ".jpg";
  File file = SD_MMC.open(filename, FILE_WRITE);

  if (file) {
    size_t written = file.write(imageData, imageSize);
    file.close();

    if (written == imageSize) {
      lastPhotoSDpath = filename;
      Serial.printf("💾 Guardada en SD: %s (%d bytes)\n", filename.c_str(), imageSize);
      return true;
    }
  }

  return false;
}

void captureAndSendPhoto(bool saveToSD, bool sendToServer) {
  photoCounter++;
  Serial.printf("\n📸 TOMANDO FOTO HD #%d\n", photoCounter);
  Serial.printf("💾 Memoria antes: %d bytes\n", ESP.getFreeHeap());

  delay(200);

  // 1. CAPTURAR FOTO
  camera_fb_t *fb = esp_camera_fb_get();
  if (!fb) {
    Serial.println("❌ Error capturando foto");
    return;
  }

  Serial.printf("✅ Foto capturada: %d bytes\n", fb->len);

  // 2. GUARDAR EN MEMORIA TEMPORAL para enviar después
  freeLastPhotoBuffer(); // Liberar foto anterior

  lastPhotoBuffer = (uint8_t*)malloc(fb->len);
  if (lastPhotoBuffer != nullptr) {
    memcpy(lastPhotoBuffer, fb->buf, fb->len);
    lastPhotoSize = fb->len;
    Serial.println("📦 Foto almacenada en buffer temporal");
  }

  // 3. GUARDAR EN SD (si se solicita)
  if (saveToSD && sdCardReady) {
    savePhotoToSD(fb->buf, fb->len);
  }

  // 4. ENVIAR AL SERVIDOR (si se solicita)
  if (sendToServer && WiFi.status() == WL_CONNECTED) {
    Serial.println("🚀 Enviando foto actual al servidor...");

    if (sendPhotoDirect(fb->buf, fb->len, "foto_actual.jpg")) {
      Serial.println("🎉 Foto ACTUAL enviada exitosamente!");
      if (bluetoothEnabled && SerialBT.hasClient()) {
        SerialBT.println("✅ Foto ACTUAL enviada al servidor!");
      }
    } else {
      Serial.println("❌ Error enviando foto actual");
    }
  }

  // 5. LIBERAR FRAME BUFFER
  esp_camera_fb_return(fb);

  Serial.printf("💾 Memoria final: %d bytes\n", ESP.getFreeHeap());
}

void sendLastCapturedPhoto() {
  if (lastPhotoBuffer == nullptr || lastPhotoSize == 0) {
    Serial.println("❌ No hay foto capturada recientemente");
    if (bluetoothEnabled && SerialBT.hasClient()) {
      SerialBT.println("❌ No hay foto capturada recientemente");
    }
    return;
  }

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ WiFi no conectado");
    if (bluetoothEnabled && SerialBT.hasClient()) {
      SerialBT.println("❌ WiFi no conectado");
    }
    return;
  }

  Serial.println("📡 Enviando última foto CAPTURADA (no de SD)...");

  if (sendPhotoDirect(lastPhotoBuffer, lastPhotoSize, "ultima_captura.jpg")) {
    Serial.println("🎉 Última foto capturada enviada!");
    if (bluetoothEnabled && SerialBT.hasClient()) {
      SerialBT.println("✅ Última foto capturada enviada!");
    }
  } else {
    Serial.println("❌ Error enviando última foto capturada");
  }
}

void processBluetoothCommand(String command) {
  command.toUpperCase();
  command.trim();

  Serial.printf("📱 Comando: %s\n", command.c_str());

  if (!SerialBT.hasClient()) return;

  if (command == "FOTO") {
    SerialBT.println("📸 Tomando foto (solo guarda en SD)...");
    captureAndSendPhoto(true, false); // Solo guarda en SD
  }
  else if (command == "ENVIAR") {
    if (WiFi.status() != WL_CONNECTED) {
      SerialBT.println("❌ WiFi no conectado");
      return;
    }
    SerialBT.println("🚀 Tomando y enviando foto ACTUAL...");
    captureAndSendPhoto(true, true); // Guarda en SD Y envía
  }
  else if (command == "REENVIAR") {
    SerialBT.println("🔄 Reenviando última foto CAPTURADA...");
    sendLastCapturedPhoto(); // Envía la última foto capturada (de RAM)
  }
  else if (command == "POST") {
    if (lastPhotoSDpath == "") {
      SerialBT.println("❌ No hay foto guardada en SD");
      return;
    }
    if (WiFi.status() != WL_CONNECTED) {
      SerialBT.println("❌ WiFi no conectado");
      return;
    }
    SerialBT.println("📡 Enviando última foto de SD...");

    File file = SD_MMC.open(lastPhotoSDpath.c_str(), FILE_READ);
    if (!file) {
      SerialBT.println("❌ Error abriendo archivo de SD");
      return;
    }

    size_t fileSize = file.size();
    uint8_t* buffer = (uint8_t*)malloc(min(fileSize, (size_t)20480));

    if (buffer) {
      file.read(buffer, fileSize);
      file.close();

      bool success = sendPhotoDirect(buffer, fileSize, lastPhotoSDpath);
      free(buffer);

      SerialBT.println(success ? "✅ Foto de SD enviada" : "❌ Error enviando");
    } else {
      SerialBT.println("❌ Error de memoria");
      file.close();
    }
  }
  else if (command == "MEMORIA") {
    SerialBT.printf("💻 Memoria: %d bytes\n", ESP.getFreeHeap());
    SerialBT.printf("📡 WiFi: %s\n", WiFi.status() == WL_CONNECTED ? "✅" : "❌");
    SerialBT.printf("📷 Fotos capturadas: %d\n", photoCounter);
    SerialBT.printf("📦 Buffer temporal: %s\n",
                   lastPhotoBuffer != nullptr ? "✅ Con foto" : "❌ Vacío");
  }
  else if (command == "LIMPIAR") {
    freeLastPhotoBuffer();
    SerialBT.println("🧹 Buffer temporal limpiado");
  }
  else {
    SerialBT.println("❌ Comando no reconocido");
    SerialBT.println("Comandos disponibles:");
    SerialBT.println("FOTO - Toma foto (guarda en SD)");
    SerialBT.println("ENVIAR - Toma y envía foto ACTUAL");
    SerialBT.println("REENVIAR - Reenvía última foto capturada");
    SerialBT.println("POST - Envía última foto de SD");
    SerialBT.println("MEMORIA - Estado del sistema");
    SerialBT.println("LIMPIAR - Limpia buffer temporal");
  }
}

void flashOn() {
  digitalWrite(FLASH_PIN, HIGH);
  delay(100);
}

void flashOff() {
  digitalWrite(FLASH_PIN, LOW);
}

void loop() {
  if (bluetoothEnabled && SerialBT.hasClient() && SerialBT.available()) {
    String command = SerialBT.readString();
    command.trim();
    processBluetoothCommand(command);
  }

  bool currentButtonState = digitalRead(BUTTON_PIN);

  if (currentButtonState != lastButtonState) {
    lastDebounceTime = millis();
  }

  if ((millis() - lastDebounceTime) > debounceDelay) {
    if (currentButtonState == LOW && !buttonPressed) {
      buttonPressed = true;
      Serial.println("🔘 Botón físico presionado");
      captureAndSendPhoto(true, false); // Solo guarda en SD
    }
    else if (currentButtonState == HIGH && buttonPressed) {
      buttonPressed = false;
    }
  }

  lastButtonState = currentButtonState;

  delay(100);
}
