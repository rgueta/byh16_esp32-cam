void setup() {
  Serial.begin(115200);
  Serial.setDebugOutput(true);
  Serial.println("\n=== ESP32-CAM HD OPTIMIZADO ===");

  Serial.printf("💾 Memoria inicial: %d bytes\n", ESP.getFreeHeap());

  pinMode(BUTTON_PIN, INPUT_PULLUP);

  // Bluetooth solo si hay memoria
  if (bluetoothEnabled && ESP.getFreeHeap() > 15000) {
    if (!SerialBT.begin(deviceName)) {
      Serial.println("❌ Error en Bluetooth");
      bluetoothEnabled = false;
    } else {
      Serial.printf("✅ Bluetooth: %s\n", deviceName);
    }
  } else {
    bluetoothEnabled = false;
    Serial.println("⚠️  Bluetooth desactivado");
  }

  // WiFi
  setupWiFi();

  // Cámara HD
  Serial.println("📷 Inicializando cámara HD...");
  if (!setupCameraHD()) {
    Serial.println("❌ Error en cámara HD!");
    return;
  }

  // SD Card
  sdCardReady = setupSDCard();

  Serial.println("\n🎯 SISTEMA LISTO (1024x768)");
  Serial.printf("💾 Memoria libre: %d bytes\n", ESP.getFreeHeap());
}

void setupWiFi() {
  Serial.printf("📡 Conectando a: %s\n", ssid);

  WiFi.setAutoReconnect(true);
  WiFi.persistent(true);

  WiFi.begin(ssid, password);

  for (int i = 0; i < 20; i++) {
    if (WiFi.status() == WL_CONNECTED) {
      Serial.println("\n✅ WiFi conectado!");
      Serial.printf("📶 IP: %s\n", WiFi.localIP().toString().c_str());
      return;
    }
    delay(1000);
    Serial.print(".");
  }
  Serial.println("\n❌ Error en WiFi");
}

bool setupCameraHD() {
  camera_config_t config;

  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;
  config.xclk_freq_hz = 10000000;

  config.pixel_format = PIXFORMAT_JPEG;
  config.frame_size = FRAMESIZE_XGA; // 1024x768
  config.jpeg_quality = 15; // Calidad optimizada
  config.fb_count = 1;
  config.fb_location = CAMERA_FB_IN_PSRAM;

  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("❌ Error cámara: 0x%x\n", err);
    return false;
  }

  Serial.printf("✅ Cámara HD lista. Memoria: %d bytes\n", ESP.getFreeHeap());
  return true;
}

bool setupSDCard() {
  if (ESP.getFreeHeap() < 10000) return false;

  if (SD_MMC.begin("/sdcard", true)) {
    if (SD_MMC.cardType() != CARD_NONE) {
      if(!SD_MMC.exists("/fotos")){
        SD_MMC.mkdir("/fotos");
      }
      Serial.println("✅ SD lista");
      return true;
    }
  }
  return false;
}

String lastPhotoPath = "";

bool sendPhotoDirect(const uint8_t* imageData, size_t imageSize, const String& filename) {
  Serial.println("\n📡 ENVIANDO FOTO (MÉTODO DIRECTO)");
  Serial.printf("📏 Tamaño: %d bytes\n", imageSize);
  Serial.printf("💾 Memoria antes: %d bytes\n", ESP.getFreeHeap());

  if (WiFi.status() != WL_CONNECTED) {
    Serial.println("❌ WiFi no conectado");
    return false;
  }

  WiFiClient client;
  Serial.println("🔗 Conectando al servidor...");

  if (!client.connect(serverHost, serverPort)) {
    Serial.println("❌ No se pudo conectar al servidor");
    return false;
  }

  Serial.println("✅ Conectado, preparando envío...");

  // Construir request - SIN buffer extra, usamos el data directo
  String headers = String("POST /upload HTTP/1.1\r\n") +
                  "Host: " + String(serverHost) + ":" + String(serverPort) + "\r\n" +
                  "Content-Type: application/octet-stream\r\n" +
                  "Authorization: " + String(authToken) + "\r\n" +
                  "Content-Length: " + String(imageSize) + "\r\n" +
                  "Connection: close\r\n\r\n";

  // Enviar headers
  client.print(headers);

  // Enviar datos DIRECTAMENTE desde imageData - SIN copia
  // Esto ahorra ~20KB de memoria!
  size_t sent = 0;
  const size_t CHUNK_SIZE = 1024; // Chunks más pequeños para ahorrar memoria

  while (sent < imageSize) {
    size_t toSend = min(CHUNK_SIZE, imageSize - sent);

    // Enviar chunk directamente desde imageData
    size_t written = client.write(imageData + sent, toSend);

    if (written == 0) {
      Serial.println("❌ Error enviando chunk");
      client.stop();
      return false;
    }

    sent += written;

    // Mostrar progreso cada 5KB
    if (sent % 5120 == 0 || sent == imageSize) {
      Serial.printf("📦 Progreso: %d/%d bytes\n", sent, imageSize);
    }

    // Pequeña pausa para evitar saturación
    delay(2);
  }

  Serial.println("✅ Datos enviados, esperando respuesta...");

  // Esperar respuesta
  unsigned long startTime = millis();
  while (!client.available() && millis() - startTime < 10000) {
    delay(10);
  }

  bool success = false;
  if (client.available()) {
    // Leer solo el inicio de la respuesta para ahorrar memoria
    String response = client.readStringUntil('\n');
    Serial.printf("📨 Respuesta: %s\n", response.c_str());

    if (response.indexOf("200") > 0 || response.indexOf("OK") > 0) {
      success = true;
      Serial.println("🎉 Foto enviada exitosamente!");
    }
  } else {
    Serial.println("❌ Timeout esperando respuesta");
  }

  client.stop();
  return success;
}

void takePhoto(bool upload = false) {
  photoCounter++;
  Serial.printf("\n📸 TOMANDO FOTO HD #%d\n", photoCounter);
  Serial.printf("💾 Memoria antes: %d bytes\n", ESP.getFreeHeap());

  delay(200);

  camera_fb_t *fb = esp_camera_fb_get();
  if (!fb) {
    Serial.println("❌ Error capturando foto");
    return;
  }

  Serial.printf("✅ Foto capturada: %d bytes\n", fb->len);

  // Guardar en SD
  if (sdCardReady) {
    String filename = "/fotos/foto_" + String(photoCounter) + ".jpg";
    File file = SD_MMC.open(filename, FILE_WRITE);
    if (file) {
      file.write(fb->buf, fb->len);
      file.close();
      lastPhotoPath = filename;
      Serial.println("💾 Guardada en SD");
    }
  }

  // Enviar si se solicita
  if (upload && WiFi.status() == WL_CONNECTED) {
    if (sendPhotoDirect(fb->buf, fb->len, "foto.jpg")) {
      Serial.println("🎉 Envío exitoso!");
      if (bluetoothEnabled && SerialBT.hasClient()) {
        SerialBT.println("✅ Foto enviada al servidor!");
      }
    } else {
      Serial.println("❌ Error en envío");
    }
  }

  esp_camera_fb_return(fb);
  Serial.printf("💾 Memoria final: %d bytes\n", ESP.getFreeHeap());
}

void processBluetoothCommand(String command) {
  command.toUpperCase();
  command.trim();

  Serial.printf("📱 Comando: %s\n", command.c_str());

  if (!SerialBT.hasClient()) return;

  if (command == "FOTO") {
    SerialBT.println("📸 Tomando foto...");
    takePhoto(false);
  }
  else if (command == "ENVIAR") {
    if (WiFi.status() != WL_CONNECTED) {
      SerialBT.println("❌ WiFi no conectado");
      return;
    }
    SerialBT.println("🚀 Tomando y enviando...");
    takePhoto(true);
  }
  else if (command == "POST") {
    if (lastPhotoPath == "") {
      SerialBT.println("❌ No hay foto");
      return;
    }
    if (WiFi.status() != WL_CONNECTED) {
      SerialBT.println("❌ WiFi no conectado");
      return;
    }
    SerialBT.println("📡 Enviando última foto...");

    File file = SD_MMC.open(lastPhotoPath.c_str(), FILE_READ);
    if (!file) {
      SerialBT.println("❌ Error abriendo archivo");
      return;
    }

    size_t fileSize = file.size();
    // Leer directamente en un buffer temporal
    uint8_t* buffer = (uint8_t*)malloc(min(fileSize, (size_t)20480)); // Máximo 20KB

    if (buffer) {
      file.read(buffer, fileSize);
      file.close();

      bool success = sendPhotoDirect(buffer, fileSize, lastPhotoPath);
      free(buffer);

      SerialBT.println(success ? "✅ Foto enviada" : "❌ Error enviando");
    } else {
      SerialBT.println("❌ Error de memoria");
      file.close();
    }
  }
  else if (command == "MEMORIA") {
    SerialBT.printf("💻 Memoria: %d bytes\n", ESP.getFreeHeap());
    SerialBT.printf("📡 WiFi: %s\n", WiFi.status() == WL_CONNECTED ? "✅" : "❌");
  }
}

void loop() {
  if (bluetoothEnabled && SerialBT.hasClient() && SerialBT.available()) {
    String command = SerialBT.readString();
    command.trim();
    processBluetoothCommand(command);
  }

  bool currentButtonState = digitalRead(BUTTON_PIN);

  if (currentButtonState != lastButtonState) {
    lastDebounceTime = millis();
  }

  if ((millis() - lastDebounceTime) > debounceDelay) {
    if (currentButtonState == LOW && !buttonPressed) {
      buttonPressed = true;
      Serial.println("🔘 Botón presionado");
      takePhoto(false);
    }
    else if (currentButtonState == HIGH && buttonPressed) {
      buttonPressed = false;
    }
  }

  lastButtonState = currentButtonState;

  delay(100);
}
